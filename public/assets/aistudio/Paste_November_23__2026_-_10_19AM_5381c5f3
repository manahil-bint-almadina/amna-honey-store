    function buildLocalKnowledgeReply(query) {
      const q = query.toLowerCase();
      if (q.includes('سعر') || q.includes('أسعار') || q.includes('نوع') || q.includes('أنواع') || q.includes('سدر') || q.includes('طلح') || q.includes('سمر')) {
        const pList = state.products.map(p =>
          `• ${p.name} (${p.available ? 'متوفر' : 'غير متوفر حالياً'}): ربع كيلو ${p.prices.quarter} ريال، نصف كيلو ${p.prices.half} ريال، كيلو ${p.prices.kilo} ريال.`
        ).join('\n');
        return `متوفر لدينا في مناحل آمنة عبد الكريم:\n${pList}\n\nيمكنك اختيار الوزن وإضافته للسلة مباشرة.`;
      }
      if (q.includes('توصيل') || q.includes('شحن') || q.includes('دفع') || q.includes('استلام') || q.includes('مدينه') || q.includes('مدينة') || q.includes('gps') || q.includes('موقع')) {
        return `آلية التوصيل والدفع:\n• داخل المدينة المنورة: التوصيل فوري مع رسوم توصيل حسب الموقع المرسل (يمكنك تحديد موقعك عبر GPS في السلة)، ويتوفر الدفع عند الاستلام.\n• خارج المدينة المنورة: التوصيل حسب المنطقة، ولا يتم الدفع عند الاستلام خارج المدينة؛ الدفع بالتحويل البنكي المسبق فقط.`;
      }
      if (q.includes('تحويل') || q.includes('ايبان') || q.includes('آيبان') || q.includes('بنك') || q.includes('راجحي') || q.includes('حساب')) {
        return `بيانات التحويل البنكي:\n• المصرف: مصرف الراجحي\n• الاسم للتحويل: ${BENEFICIARY_NAME}\n• الآيبان: ${DEFAULT_IBAN}\n\nلتأكيد الطلب يرجى ترك رسالة أو تحويل مبلغ العسل المطلوب وإرسال الإيصال والطلبات عبر الواتساب.`;
      }
      return `أهلاً بك! تتوفر لدينا أنواع العسل (سدرة، طلح، سمرة) بأسعار: ربع كيلو 150 ريال، نصف كيلو 250 ريال، وكيلو 400 ريال. التوصيل داخل المدينة فوري مع إمكانية الدفع عند الاستلام، وخارج المدينة بالتحويل المسبق فقط. كما يمكنك التواصل مباشرة عبر الواتساب (${formatDisplayPhone(state.whatsapp)}).`;
    }

    async function handleChatSubmit(e) {
      e.preventDefault();
      const input = document.getElementById('chatInput');
      const text = input.value.trim();
      if (!text) return;

      chatHistory.push({ role: 'user', text });
      input.value = '';
      renderChatMessages();

      if (state.geminiApiKey && state.geminiApiKey.trim().startsWith('AIza')) {
        try {
          const systemPrompt = `أنت مساعد ذكي ودود ومهذب لمشروع "مناحل آمنة عبد الكريم" في المدينة المنورة. أجب بالعربية بوضوح ودقة بناءً على المعلومات التالية فقط:
- الأنواع المتوفرة: عسل سدرة بلدي، عسل طلح بلدي، عسل سمرة بلدي.
- الأسعار الموحدة لكل نوع: ربع كيلو 150 ريال، نصف كيلو 250 ريال، كيلو 400 ريال.
- التوصيل داخل المدينة المنورة: فوري مع رسوم توصيل حسب الموقع المرسل، ويدعم ميزة تحديد الموقع عبر GPS في السلة، ويوجد دفع عند الاستلام داخل المدينة المنورة فقط.
- التوصيل خارج المدينة المنورة: حسب المنطقة، ولا يتم التوصيل عند الاستلام خارج المدينة (تحويل مسبق فقط).
- التحويل البنكي: مصرف الراجحي، الاسم: آمنة عبد الكريم، الآيبان: ${DEFAULT_IBAN}.
- لتأكيد الطلب: ترك رسالة أو تحويل المبلغ وإرسال الإيصال والطلبات عبر الواتساب (${formatDisplayPhone(state.whatsapp)}).`;

          const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${encodeURIComponent(state.geminiApiKey.trim())}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              contents: [{ parts: [{ text: `${systemPrompt}\n\nسؤال العميل: ${text}` }] }]
            })
          });
          const data = await res.json();
          const reply = data?.candidates?.[0]?.content?.parts?.[0]?.text || buildLocalKnowledgeReply(text);
          chatHistory.push({ role: 'assistant', text: reply });
          renderChatMessages();
          return;
        } catch {
          // Fallback to local knowledge reply
        }
      }

      const localReply = buildLocalKnowledgeReply(text);
      chatHistory.push({ role: 'assistant', text: localReply });
      renderChatMessages();
    }

