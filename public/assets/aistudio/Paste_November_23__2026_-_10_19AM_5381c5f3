    function detectGPSLocation() {
      const gpsBtn = document.getElementById('gpsBtn');
      const statusBox = document.getElementById('gpsStatusBox');
      const statusText = document.getElementById('gpsStatusText');
      const mapLink = document.getElementById('gpsMapLink');

      if (!navigator.geolocation) {
        showToast('المتصفح لا يدعم GPS، يمكنك كتابة العنوان يدوياً');
        return;
      }

      gpsBtn.disabled = true;
      gpsBtn.innerHTML = '<span>جاري التحديد...</span>';

      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const lat = pos.coords.latitude.toFixed(6);
          const lng = pos.coords.longitude.toFixed(6);
          const url = `https://maps.google.com/?q=${lat},${lng}`;
          gpsCoords = { lat, lng, url };

          statusBox.classList.remove('hidden');
          statusText.textContent = `تم تحديد الموقع (${lat}, ${lng})`;
          mapLink.href = url;

          const addrInput = document.getElementById('customerAddress');
          if (!addrInput.value.trim()) {
            addrInput.value = `موقع GPS (${lat}, ${lng})`;
          }

          gpsBtn.disabled = false;
          gpsBtn.innerHTML = '<i data-lucide="map-pin" class="w-3.5 h-3.5"></i><span>تحديث GPS</span>';
          lucide.createIcons();
          showToast('تم تحديد موقعك الجغرافي بنجاح');
        },
        (err) => {
          gpsBtn.disabled = false;
          gpsBtn.innerHTML = '<i data-lucide="map-pin" class="w-3.5 h-3.5"></i><span>تحديد موقعي GPS</span>';
          lucide.createIcons();
          showToast('تعذر الوصول للموقع، يمكنك كتابة الحي والعنوان يدوياً');
        },
        { enableHighAccuracy: true, timeout: 10000 }
      );
    }

    function sendOrderToWhatsApp() {
      if (cart.length === 0) {
        showToast('أضف صنفاً واحداً على الأقل إلى السلة أولاً');
        return;
      }

      const name = document.getElementById('customerName').value.trim();
      const address = document.getElementById('customerAddress').value.trim();
      const payment = document.querySelector('input[name="paymentMethod"]:checked')?.value || 'تحويل بنكي (مصرف الراجحي)';
      const totalPrice = cart.reduce((acc, item) => acc + (item.unitPrice * item.qty), 0);
      const zoneLabel = deliveryZone === 'inside' ? 'داخل المدينة المنورة (توصيل فوري)' : 'خارج المدينة المنورة (حسب المنطقة)';

      let lines = [
        'السلام عليكم أستاذة آمنة عبد الكريم، أرغب بتأكيد طلب العسل التالي:',
        ''
      ];

      if (name) lines.push(`• الاسم: ${name}`);
      lines.push(`• نطاق التوصيل: ${zoneLabel}`);
      if (address) lines.push(`• العنوان / الحي: ${address}`);
      if (gpsCoords?.url) lines.push(`• موقع GPS على الخريطة: ${gpsCoords.url}`);
      lines.push(`• طريقة الدفع: ${payment}`);
      lines.push('');
      lines.push('الطلبات المطلوبة:');

      cart.forEach((item, i) => {
        lines.push(`${i + 1}) ${item.name} — ${item.weightLabel} × ${item.qty} = ${item.unitPrice * item.qty} ريال`);
      });

      lines.push('');
      lines.push(`الإجمالي (قبل التوصيل): ${totalPrice} ريال`);
      lines.push('');
      lines.push('ملاحظة: لتأكيد الطلب يرجى إرسال الإيصال في حال التحويل البنكي، أو تأكيد الموقع للتوصيل الفوري.');

      const cleanWa = (state.whatsapp || '966597176168').replace(/\D/g, '');
      const waUrl = `https://wa.me/${cleanWa}?text=${encodeURIComponent(lines.join('\n'))}`;
      window.open(waUrl, '_blank', 'noopener,noreferrer');
    }

