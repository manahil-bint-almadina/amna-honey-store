<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>مناحل آمنة عبد الكريم | عسل بلدي أصيل من المدينة المنورة</title>
  <meta name="theme-color" content="#163225" />

  <!-- Google Fonts: Amiri & Tajawal -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Tajawal:wght@300;400;500;700;800&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            emeraldDeep: '#163225',
            emeraldSoft: '#224A38',
            honeyGold: '#C59B27',
            honeyLight: '#E5C158',
            creamBase: '#FAF7F2',
            creamCard: '#FFFFFF',
            inkDark: '#1A241F',
            inkMuted: '#5C6B63',
          },
          fontFamily: {
            serifDisplay: ['Amiri', 'serif'],
            sansBody: ['Tajawal', 'sans-serif'],
          },
          boxShadow: {
            luxury: '0 20px 45px -15px rgba(22, 50, 37, 0.12)',
            goldGlow: '0 10px 25px -5px rgba(197, 155, 39, 0.35)',
          },
        },
      },
    };
  </script>

  <style>
    html {
      scroll-behavior: smooth;
    }
    body {
      font-family: 'Tajawal', sans-serif;
      background-color: #FAF7F2;
      color: #1A241F;
      overflow-x: hidden;
    }
    h1, h2, h3, .font-display {
      font-family: 'Amiri', serif;
    }
    .honeycomb-bg {
      background-image:
        radial-gradient(circle at 15% 20%, rgba(197, 155, 39, 0.08) 0%, transparent 45%),
        radial-gradient(circle at 85% 75%, rgba(22, 50, 37, 0.07) 0%, transparent 50%);
    }
    .glass-panel {
      background: rgba(255, 255, 255, 0.88);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #F1ECE1;
    }
    ::-webkit-scrollbar-thumb {
      background: #C59B27;
      border-radius: 9999px;
    }
  </style>
</head>
<body class="honeycomb-bg min-h-screen flex flex-col">

  <!-- Toast Notification -->
  <div id="toast" class="fixed top-5 left-1/2 -translate-x-1/2 z-[100] hidden transition-all duration-300">
    <div id="toastInner" class="bg-emeraldDeep text-creamBase px-5 py-3 rounded-full shadow-luxury border border-honeyGold/40 flex items-center gap-2 text-sm font-medium">
      <i data-lucide="check-circle-2" class="w-4 h-4 text-honeyLight"></i>
      <span id="toastText">تم النسخ بنجاح</span>
    </div>
  </div>

  <!-- Top Navigation Header -->
  <header class="sticky top-0 z-40 glass-panel border-b border-honeyGold/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-3">
      <!-- Brand -->
      <a href="#" class="flex items-center gap-3 group">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-emeraldDeep to-emeraldSoft border border-honeyGold/50 flex items-center justify-center shadow-md group-hover:scale-105 transition">
          <i data-lucide="hexagon" class="w-6 h-6 text-honeyLight fill-honeyGold/20"></i>
        </div>
        <div>
          <span class="block font-display text-xl sm:text-2xl font-bold text-emeraldDeep leading-tight">مناحل آمنة عبد الكريم</span>
          <span class="block text-xs text-inkMuted font-medium">عسل بلدي أصيل من قلب المدينة المنورة</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-7 text-sm font-semibold text-inkDark">
        <a href="#story" class="hover:text-honeyGold transition">قصتنا والعناية</a>
        <a href="#products" class="hover:text-honeyGold transition">متجر العسل</a>
        <a href="#diary" class="hover:text-honeyGold transition">يوميات المنحل</a>
        <a href="#delivery-info" class="hover:text-honeyGold transition">التوصيل والدفع</a>
      </nav>

      <!-- Actions: WhatsApp & Cart -->
      <div class="flex items-center gap-2.5">
        <a id="headerWhatsappBtn" href="#" target="_blank" rel="noopener noreferrer"
           class="hidden sm:inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-emeraldDeep text-creamBase hover:bg-emeraldSoft text-xs font-bold transition shadow-sm">
          <i data-lucide="message-circle" class="w-4 h-4 text-honeyLight"></i>
          <span>تواصل واتساب</span>
        </a>

        <button onclick="openCart()" class="relative inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-l from-honeyGold to-honeyLight text-emeraldDeep font-extrabold text-xs sm:text-sm shadow-goldGlow hover:brightness-105 transition cursor-pointer">
          <i data-lucide="shopping-bag" class="w-4 h-4"></i>
          <span>السلة</span>
          <span id="cartBadge" class="bg-emeraldDeep text-honeyLight text-xs font-bold px-2 py-0.5 rounded-full">0</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Hero & Story Section -->
  <section id="story" class="relative pt-10 pb-16 sm:pt-16 sm:pb-24 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-12 gap-10 items-center">
      <!-- Text Side -->
      <div class="lg:col-span-7 space-y-6 text-right">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emeraldDeep/5 border border-honeyGold/40 text-emeraldDeep text-xs sm:text-sm font-bold">
          <i data-lucide="sparkles" class="w-4 h-4 text-honeyGold"></i>
          <span>رعاية يدوية أمينة • فرز طبيعي • المدينة المنورة</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-emeraldDeep leading-[1.2]">
          أمانة اليد، وصفاء الطبيعة في كل قطرة عسل
        </h1>

        <p class="text-base sm:text-lg text-inkMuted leading-relaxed max-w-2xl">
          تُشرف النحّالة <strong class="text-emeraldDeep">آمنة عبد الكريم</strong> بنفسها على خلايا النحل في المدينة المنورة، وتتابع مواسم التزهير، وتعتني بالخلايا والفرز بكل إتقان وتفانٍ، لتقدم لكم عسل <span class="text-emeraldDeep font-bold">السدرة</span> و<span class="text-emeraldDeep font-bold">الطلح</span> و<span class="text-emeraldDeep font-bold">السمرة</span> بجودة تليق بضيوف المدينة وأهلها.
        </p>

        <div class="flex flex-wrap items-center gap-3.5 pt-2">
          <a href="#products" class="inline-flex items-center gap-2.5 px-7 py-3.5 rounded-2xl bg-gradient-to-l from-honeyGold to-honeyLight text-emeraldDeep font-extrabold text-sm sm:text-base shadow-goldGlow hover:-translate-y-0.5 transition">
            <span>تصفح واطلب العسل الآن</span>
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
          </a>
          <a href="#diary" class="inline-flex items-center gap-2 px-6 py-3.5 rounded-2xl bg-white border border-emeraldDeep/15 text-emeraldDeep font-bold text-sm sm:text-base hover:border-honeyGold transition shadow-sm">
            <i data-lucide="sun" class="w-4 h-4 text-honeyGold"></i>
            <span>كيف نعتني بالنحل؟</span>
          </a>
        </div>

        <!-- Trust Highlights -->
        <div class="grid grid-cols-3 gap-3 sm:gap-5 pt-4 border-t border-emeraldDeep/10 max-w-xl">
          <div class="bg-white/80 rounded-2xl p-3 sm:p-4 border border-honeyGold/20">
            <div class="text-xl sm:text-2xl font-extrabold text-emeraldDeep">3 أنواع</div>
            <div class="text-xs text-inkMuted mt-0.5">سدرة • طلح • سمرة</div>
          </div>
          <div class="bg-white/80 rounded-2xl p-3 sm:p-4 border border-honeyGold/20">
            <div class="text-xl sm:text-2xl font-extrabold text-emeraldDeep">توصيل فوري</div>
            <div class="text-xs text-inkMuted mt-0.5">داخل المدينة المنورة</div>
          </div>
          <div class="bg-white/80 rounded-2xl p-3 sm:p-4 border border-honeyGold/20">
            <div class="text-xl sm:text-2xl font-extrabold text-emeraldDeep">عناية مباشرة</div>
            <div class="text-xs text-inkMuted mt-0.5">بإشراف النحّالة نفسها</div>
          </div>
        </div>
      </div>

      <!-- Visual Showcase Side -->
      <div class="lg:col-span-5">
        <div class="relative rounded-[2rem] overflow-hidden shadow-luxury border-2 border-honeyGold/35 bg-emeraldDeep text-creamBase">
          <img
            src="https://images.unsplash.com/photo-1587049352846-4a222e784d38?auto=format&fit=crop&w=1000&q=80"
            alt="عسل بلدي فاخر وقرص شمع طبيعي"
            class="w-full h-[380px] sm:h-[450px] object-cover opacity-85"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-emeraldDeep via-emeraldDeep/40 to-transparent"></div>
          <div class="absolute bottom-0 inset-x-0 p-6 sm:p-7 space-y-2">
            <span class="inline-block px-3 py-1 rounded-full bg-honeyGold/25 border border-honeyLight/40 text-honeyLight text-xs font-bold">
              إنتاج بلدي موثوق
            </span>
            <h2 class="text-2xl sm:text-3xl font-bold text-white">نقاء يبدأ من الخلية وينتهي عند مائدتك</h2>
            <p class="text-xs sm:text-sm text-creamBase/85 leading-relaxed">
              متابعة مستمرة لصحة النحل وتهيئة البيئة المناسبة لكل موسم لضمان جودة القوام والنكهة.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Products Store Section -->
  <section id="products" class="py-16 sm:py-24 bg-white/60 border-y border-honeyGold/15">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
        <span class="text-xs sm:text-sm font-extrabold tracking-wide text-honeyGold uppercase">تشكيلة العسل البلدي</span>
        <h2 class="text-3xl sm:text-5xl font-bold text-emeraldDeep">اختر نوع العسل والوزن المناسب</h2>
        <p class="text-sm sm:text-base text-inkMuted">
          أسعار موحدة وواضحة لجميع الأنواع: <strong class="text-emeraldDeep">ربع كيلو (150 ر.س)</strong> • <strong class="text-emeraldDeep">نصف كيلو (250 ر.س)</strong> • <strong class="text-emeraldDeep">كيلو (400 ر.س)</strong>
        </p>
      </div>

      <div id="productsGrid" class="grid md:grid-cols-3 gap-7 lg:gap-8">
        <!-- Rendered dynamically via JS -->
      </div>
    </div>
  </section>

  <!-- Beekeeping Diary Section -->
  <section id="diary" class="py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
        <div class="space-y-2">
          <span class="text-xs sm:text-sm font-extrabold text-honeyGold">شفافية وثقة في كل خطوة</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-emeraldDeep">يوميات المنحل والعناية بالنحل</h2>
          <p class="text-sm sm:text-base text-inkMuted max-w-2xl">
            تعرّف على كيف تعتني النحّالة آمنة عبد الكريم بخلايا النحل وتتابع مراحل الموسم خطوة بخطوة.
          </p>
        </div>
      </div>

      <div id="diaryGrid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Rendered dynamically via JS -->
      </div>
    </div>
  </section>

  <!-- Delivery & Payment Policy Section -->
  <section id="delivery-info" class="py-14 sm:py-20 bg-emeraldDeep text-creamBase">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10 space-y-2">
        <span class="text-xs font-bold text-honeyLight">آلية الطلب والتسليم</span>
        <h2 class="text-3xl sm:text-4xl font-bold text-white">التوصيل والدفع بكل وضوح ويسر</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <!-- Inside Madinah -->
        <div class="rounded-3xl bg-emeraldSoft/80 border border-honeyGold/25 p-6 space-y-3">
          <div class="w-11 h-11 rounded-2xl bg-honeyGold/20 flex items-center justify-center text-honeyLight">
            <i data-lucide="zap" class="w-5 h-5"></i>
          </div>
          <h3 class="text-2xl font-bold text-honeyLight">داخل المدينة المنورة</h3>
          <p class="text-sm text-creamBase/90 leading-relaxed">
            التوصيل <strong>فوري</strong> مع احتساب رسوم التوصيل حسب الموقع المرسل (ويمكنك تحديد موقعك عبر GPS مباشرة في السلة).
          </p>
          <p class="text-xs text-honeyLight font-bold pt-1">
            ✓ يتوفر الدفع عند الاستلام داخل المدينة المنورة فقط.
          </p>
        </div>

        <!-- Outside Madinah -->
        <div class="rounded-3xl bg-emeraldSoft/80 border border-honeyGold/25 p-6 space-y-3">
          <div class="w-11 h-11 rounded-2xl bg-honeyGold/20 flex items-center justify-center text-honeyLight">
            <i data-lucide="truck" class="w-5 h-5"></i>
          </div>
          <h3 class="text-2xl font-bold text-honeyLight">خارج المدينة المنورة</h3>
          <p class="text-sm text-creamBase/90 leading-relaxed">
            التوصيل والشحن متاح إلى مختلف المناطق وتُحدد آليته وتكلفته بحسب المنطقة.
          </p>
          <p class="text-xs text-amber-200 font-bold pt-1">
            ✕ لا يتوفر الدفع عند الاستلام خارج المدينة؛ الدفع بالتحويل المسبق فقط.
          </p>
        </div>

        <!-- Bank Transfer -->
        <div class="rounded-3xl bg-white text-inkDark p-6 space-y-3 shadow-luxury">
          <div class="flex items-center justify-between">
            <span class="text-xs font-extrabold px-3 py-1 rounded-full bg-emeraldDeep/10 text-emeraldDeep">مصرف الراجحي</span>
            <i data-lucide="landmark" class="w-5 h-5 text-honeyGold"></i>
          </div>
          <h3 class="text-2xl font-bold text-emeraldDeep">بيانات التحويل البنكي</h3>
          <div class="text-sm space-y-1.5">
            <div><span class="text-inkMuted">الاسم للتحويل:</span> <strong class="text-emeraldDeep">آمنة عبد الكريم</strong></div>
            <div class="bg-creamBase p-2.5 rounded-xl border border-honeyGold/30 flex items-center justify-between gap-2">
              <code id="staticIbanText" class="text-xs font-bold text-emeraldDeep select-all">SA09 8000 0272 6080 1030 2900</code>
              <button onclick="copyIban()" class="px-2.5 py-1 rounded-lg bg-emeraldDeep text-honeyLight text-xs font-bold hover:bg-emeraldSoft transition cursor-pointer shrink-0">
                نسخ الآيبان
              </button>
            </div>
          </div>
          <p class="text-xs text-inkMuted leading-relaxed">
            لتأكيد الطلب يرجى ترك رسالة أو تحويل مبلغ العسل المطلوب وإرسال الإيصال والطلبات التي تودها عبر الواتساب.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="mt-auto bg-[#10251B] text-creamBase/80 py-8 border-t border-honeyGold/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs sm:text-sm">
      <div>
        <strong class="text-white">مناحل آمنة عبد الكريم</strong> — عسل بلدي من المدينة المنورة • واتساب: <span id="footerPhoneDisplay">0597176168</span>
      </div>
      <div class="flex items-center gap-4">
        <button onclick="openAdminModal()" class="inline-flex items-center gap-1.5 text-honeyLight/80 hover:text-honeyLight underline underline-offset-4 cursor-pointer">
          <i data-lucide="lock" class="w-3.5 h-3.5"></i>
          <span>إدارة المنحل</span>
        </button>
      </div>
    </div>
  </footer>

  <!-- Cart Drawer Modal -->
  <div id="cartDrawer" class="fixed inset-0 z-50 hidden">
    <div onclick="closeCart()" class="fixed inset-0 bg-black/55 backdrop-blur-xs"></div>
    <div class="fixed inset-y-0 left-0 max-w-lg w-full bg-creamBase shadow-2xl flex flex-col z-10 border-r border-honeyGold/30">
      <!-- Header -->
      <div class="p-5 bg-emeraldDeep text-creamBase flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <i data-lucide="shopping-bag" class="w-5 h-5 text-honeyLight"></i>
          <h3 class="font-display text-2xl font-bold text-white">سلة الطلبات</h3>
        </div>
        <button onclick="closeCart()" class="p-2 rounded-xl hover:bg-white/10 transition cursor-pointer">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <!-- Body -->
      <div class="flex-1 overflow-y-auto p-5 space-y-5">
        <!-- Items List -->
        <div id="cartItemsContainer" class="space-y-3">
          <!-- Rendered by JS -->
        </div>

        <!-- Customer & Delivery Form -->
        <div id="checkoutFormBox" class="bg-white rounded-2xl p-4 sm:p-5 border border-honeyGold/25 space-y-4 shadow-xs">
          <h4 class="font-bold text-emeraldDeep text-sm flex items-center gap-2">
            <i data-lucide="user-check" class="w-4 h-4 text-honeyGold"></i>
            <span>بيانات العميل والتوصيل</span>
          </h4>

          <div>
            <label class="block text-xs font-bold text-inkDark mb-1">الاسم الكامل *</label>
            <input id="customerName" type="text" placeholder="اكتب اسمك الكريم"
                   class="w-full px-3.5 py-2.5 rounded-xl bg-creamBase border border-emeraldDeep/15 text-sm focus:outline-none focus:border-honeyGold" />
          </div>

          <!-- Location Zone -->
          <div>
            <label class="block text-xs font-bold text-inkDark mb-1.5">موقع التوصيل *</label>
            <div class="grid grid-cols-2 gap-2.5">
              <button type="button" id="zoneInsideBtn" onclick="setDeliveryZone('inside')"
                      class="p-3 rounded-xl border-2 text-right transition cursor-pointer border-emeraldDeep bg-emeraldDeep/5">
                <div class="text-xs font-extrabold text-emeraldDeep">داخل المدينة المنورة</div>
                <div class="text-[11px] text-inkMuted mt-0.5">توصيل فوري + دفع عند الاستلام</div>
              </button>
              <button type="button" id="zoneOutsideBtn" onclick="setDeliveryZone('outside')"
                      class="p-3 rounded-xl border-2 text-right transition cursor-pointer border-emeraldDeep/15 bg-white">
                <div class="text-xs font-extrabold text-emeraldDeep">خارج المدينة المنورة</div>
                <div class="text-[11px] text-inkMuted mt-0.5">حسب المنطقة • تحويل مسبق</div>
              </button>
            </div>
            <p id="zonePolicyNote" class="text-xs text-emeraldDeep bg-amber-50 border border-amber-200 rounded-xl p-2.5 mt-2 leading-relaxed">
              التوصيل داخل المدينة المنورة فوري مع رسوم توصيل حسب الموقع المرسل.
            </p>
          </div>

          <!-- GPS Location Picker -->
          <div class="space-y-2">
            <div class="flex items-center justify-between gap-2">
              <label class="text-xs font-bold text-inkDark">العنوان / الحي أو الموقع الجغرافي (GPS)</label>
              <button type="button" id="gpsBtn" onclick="detectGPSLocation()"
                      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emeraldDeep text-honeyLight text-xs font-bold hover:bg-emeraldSoft transition cursor-pointer">
                <i data-lucide="map-pin" class="w-3.5 h-3.5"></i>
                <span>تحديد موقعي GPS</span>
              </button>
            </div>

            <input id="customerAddress" type="text" placeholder="مثال: المدينة المنورة - حي العزيزية أو تفاصيل العنوان"
                   class="w-full px-3.5 py-2.5 rounded-xl bg-creamBase border border-emeraldDeep/15 text-sm focus:outline-none focus:border-honeyGold" />

            <div id="gpsStatusBox" class="hidden text-xs rounded-xl p-2.5 bg-emerald-50 border border-emerald-200 text-emerald-900 flex items-center justify-between gap-2">
              <span id="gpsStatusText" class="truncate">تم التقاط الموقع</span>
              <a id="gpsMapLink" href="#" target="_blank" rel="noopener noreferrer" class="underline font-bold shrink-0">عرض الخريطة</a>
            </div>
          </div>

          <!-- Payment Method -->
          <div>
            <label class="block text-xs font-bold text-inkDark mb-1.5">طريقة الدفع *</label>
            <div class="grid grid-cols-2 gap-2.5">
              <label id="payCodLabel" class="flex items-center gap-2 p-3 rounded-xl border border-emeraldDeep/20 bg-creamBase cursor-pointer text-xs font-bold">
                <input type="radio" name="paymentMethod" value="الدفع عند الاستلام (داخل المدينة المنورة)" checked onchange="togglePaymentBox()" class="accent-emeraldDeep" />
                <span>الدفع عند الاستلام</span>
              </label>
              <label id="payTransferLabel" class="flex items-center gap-2 p-3 rounded-xl border border-emeraldDeep/20 bg-creamBase cursor-pointer text-xs font-bold">
