      `).join('');
    }

    function addToCart(productId) {
      const prod = state.products.find(p => p.id === productId);
      if (!prod || !prod.available) return;
      const weight = selectedWeights[productId] || 'kilo';
      const unitPrice = prod.prices[weight];
      const existing = cart.find(i => i.productId === productId && i.weight === weight);

      if (existing) {
        existing.qty += 1;
      } else {
        cart.push({
          key: `${productId}_${weight}`,
          productId,
          name: prod.name,
          weight,
          weightLabel: weightLabels[weight],
          unitPrice,
          qty: 1
        });
      }
      updateCartUI();
      showToast(`تمت إضافة ${prod.name} (${weightLabels[weight]}) إلى السلة`);
    }

    function changeCartQty(index, delta) {
      if (!cart[index]) return;
      cart[index].qty += delta;
      if (cart[index].qty <= 0) {
        cart.splice(index, 1);
      }
      updateCartUI();
    }

